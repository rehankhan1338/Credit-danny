# Copy to .env.local (gitignored) for local dev; set the same variables in
# your host's dashboard (e.g. `vercel env add`) for deployments.

# WordPress origin — used by the blog proxy (next.config.ts) AND the REST API
# fetches (lib/wp.ts). BEFORE pointing creditdanny.com DNS at this deployment,
# change this to a hostname that still reaches WordPress directly
# (e.g. https://origin.creditdanny.com), or the proxy will loop.
WP_ORIGIN=https://creditdanny.com

# OPTIONAL — only needed if the WP REST API is ever locked down. Published
# posts are public today, so leave these unset. If you do need them:
# in wp-admin go to Users -> Profile -> Application Passwords, create one
# named "nextjs", and paste it here. NEVER use the real admin password, and
# NEVER commit this file's .env.local copy.
# WP_APP_USER=
# WP_APP_PASSWORD=
